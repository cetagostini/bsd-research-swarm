/-!
## p-adic Regulator (Rank 2)
-/

/-- The p-adic height pairing for two points `P, Q ∈ E(ℚ)`. -/
noncomputable def padicHeightPairing {p : ℕ} (hp : Nat.Prime p)
    (E : Type*) (P Q : ℤ × ℤ) : ℚ_[p] :=
  sorry  -- ĥ_p(P+Q) - ĥ_p(P) - ĥ_p(Q)

/-- The 2×2 p-adic height pairing matrix for generators `P₁, P₂` of `E(ℚ)/tors`. -/
noncomputable def padicRegulatorMatrixRank2 {p : ℕ} (hp : Nat.Prime p)
    (E : Type*) (P₁ P₂ : ℤ × ℤ) : Matrix (Fin 2) (Fin 2) ℚ_[p] :=
  Matrix.of (fun i j =>
    match i, j with
    | 0, 0 => padicHeightPairing hp E P₁ P₁
    | 0, 1 => padicHeightPairing hp E P₁ P₂
    | 1, 0 => padicHeightPairing hp E P₂ P₁
    | 1, 1 => padicHeightPairing hp E P₂ P₂)

/-- The p-adic regulator for rank 2: `Reg_p(E) = det(H_p)`. -/
noncomputable def padicRegulatorRank2 {p : ℕ} (hp : Nat.Prime p)
    (E : Type*) (P₁ P₂ : ℤ × ℤ) : ℚ_[p] :=
  (padicRegulatorMatrixRank2 hp E P₁ P₂).det

