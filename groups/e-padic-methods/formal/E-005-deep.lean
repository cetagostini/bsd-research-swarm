/-- **Comparison Theorem (Nekovář 1993, 2006).**
    Under the compatibility between p-adic and complex L-functions:
    `Reg_p / Reg_∞ = (Ω_p / Ω_E)^r * u_p`
    where `u_p ∈ ℤ_p^×` is a p-adic unit and `r` is the rank.

    For rank 2: `Reg_p / Reg_∞ = (Ω_p / Ω_E)² * u_p` -/
theorem padic_classical_regulator_comparison {p : ℕ} (hp : Nat.Prime p)
    (E : Type*) (P₁ P₂ : ℤ × ℤ) (u_p : ℚ_[p]) (h_unit : IsUnit u_p) :
    ∃ (Reg_p Reg_∞ : ℚ_[p]) (Ω_p Ω_E : ℚ_[p]),
    Reg_p / Reg_∞ = (Ω_p / Ω_E)^2 * u_p := by
  sorry  -- Requires formalisation of Nekovář's comparison theorem

/-!
## Supersingular Case (p = 3)
-/

/-- The plus/minus p-adic heights for supersingular primes. -/
noncomputable def padicHeightPlus {p : ℕ} (hp : Nat.Prime p)
    (E : Type*) (P : ℤ × ℤ) : ℚ_[p] :=
  sorry

noncomputable def padicHeightMinus {p : ℕ} (hp : Nat.Prime p)
    (E : Type*) (P : ℤ × ℤ) : ℚ_[p] :=
  sorry

/-- The plus/minus p-adic regulator for rank 2 at a supersingular prime. -/
noncomputable def padicRegulatorPlusMinus {p : ℕ} (hp : Nat.Prime p)
    (E : Type*) (P₁ P₂ : ℤ × ℤ) : ℚ_[p] :=
  let H := Matrix.of (fun i j =>
    match i, j with
    | 0, 0 => padicHeightPlus hp E P₁ + padicHeightMinus hp E P₁
    | 0, 1 => (padicHeightPlus hp E (P₁ + P₂) - padicHeightPlus hp E P₁
               - padicHeightPlus hp E P₂) +
              (padicHeightMinus hp E (P₁ + P₂) - padicHeightMinus hp E P₁
               - padicHeightMinus hp E P₂)
    | 1, 0 => (padicHeightPlus hp E (P₂ + P₁) - padicHeightPlus hp E P₂
               - padicHeightPlus hp E P₁) +
              (padicHeightMinus hp E (P₂ + P₁) - padicHeightMinus hp E P₂
               - padicHeightMinus hp E P₁)
    | 1, 1 => padicHeightPlus hp E P₂ + padicHeightMinus hp E P₂)
  H.det

/-- **Conjecture (Supersingular p-adic BSD, rank 2).**
    For `E/ℚ` with supersingular reduction at `p` and rank 2:
    The plus/minus p-adic L-functions satisfy an analogous formula
    with `Reg_p^±` replacing `Reg_p`. -/
conjecture supersingular_padic_bsd_rank2 {p : ℕ} (hp : Nat.Prime p)
    (E : Type*) (P₁ P₂ : ℤ × ℤ) :
    -- L_p^{±,(2)}(E,1)/2 = (Sha/|tors|²) * Reg_p^{±}(E) * ∏ c_ℓ^{(p)}
    True

