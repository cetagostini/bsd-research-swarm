    For GL₂ over ℚ_p, this gives a map from 2-dimensional
    representations of G_{ℚ_p} to smooth representations of GL₂(ℚ_p). -/
def farguesScholzeLocalLanglands (p : ℕ) : Prop :=
  True  -- placeholder for the local Langlands in families

