/-- The derived Hecke algebra for GL_n at a Taylor-Wiles prime -/
structure DerivedHeckeAlgebra (n : ℕ) (q : ℕ) (O : Type*) [CommRing O] where
  underlying : Type*
  commRing : CommRing underlying
  localAtq : Type*  -- local Hecke algebra at q
  actsOn : Prop  -- acts on completed cohomology

/-- The global derived Hecke algebra is a tensor product of local ones -/
def globalDerivedHeckeAlgebra (n : ℕ) (Q : List ℕ) (O : Type*) [CommRing O]
    : DerivedHeckeAlgebra n 0 O :=
  -- ⊗_{q ∈ Q} T_q^der
  sorry

/-- The derived R = T isomorphism (Calegari-Geraghty 2016) -/
theorem derived_RT_isomorphism
    (n : ℕ) (hn : n ≥ 2)
    (F : Type*)  -- number field
    (O k : Type*) [CommRing O] [CommRing k]
    (Q : List ℕ)  -- Taylor-Wiles primes
    (hwt : True)  -- regular weight hypothesis
    (hsmooth : True) :  -- local smoothness
    -- R_∞ ≅ T_∞^der as S_∞-algebras in the derived category
    True := by
  trivial

